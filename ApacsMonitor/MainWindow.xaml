<Window x:Class="ApacsMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="APACS Monitor — Журнал доступа" Icon="{StaticResource AppIcon}" Width="1400" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="FilterButton" TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="ActiveFilterButton" TargetType="Button" BasedOn="{StaticResource FilterButton}"><Setter Property="Background" Value="#17202A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#17202A"/></Style>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E8EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
        <DataTemplate x:Key="EmployeeCardTemplate"><Border Style="{StaticResource CardStyle}" Width="350"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="54" Height="54" CornerRadius="27" Background="#EAF0F8"><Image Source="{StaticResource AppIcon}" Width="30" Height="30"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Сотрудник" FontSize="12" Foreground="#7A8491"/><TextBlock Text="{Binding InitObjectName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="APACS" FontSize="12" Foreground="#9AA3AE"/></StackPanel></Grid><Border Grid.Row="2" Background="#F5F7FA" CornerRadius="10" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="СОБЫТИЕ" FontSize="11" FontWeight="Bold" Foreground="#68727E"/><TextBlock Text="{Binding RealTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" FontSize="14" Foreground="#303944"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding EventType}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/></Grid></Border><TextBlock Grid.Row="3" Margin="2,12,0,0" Text="Техническое событие APACS — ожидается привязка к реальному пробитию карты" FontSize="11" Foreground="#A06B00" TextWrapping="Wrap"/></Grid></Border></DataTemplate>
    </Window.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="{StaticResource AppIcon}" Width="52" Height="52" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitleText" Text="APACS Monitor" FontSize="30" FontWeight="Bold" Foreground="#17202A"/><TextBlock x:Name="SubtitleText" Text="Журнал доступа сотрудников" FontSize="14" Foreground="#7A8491"/></StackPanel></StackPanel><ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="145" Height="38" SelectedIndex="0" SelectionChanged="LanguageComboBox_SelectionChanged"><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Türkçe" Tag="tr"/></ComboBox></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,16"><Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="11" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="22" VerticalAlignment="Center" Foreground="#68727E"/><TextBox x:Name="SearchTextBox" Grid.Column="1" BorderThickness="0" FontSize="15" Margin="10,0,0,0" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"/><TextBlock x:Name="SearchHint" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#A0A8B2" Text="Поиск по ФИО или номеру карты" IsHitTestVisible="False"/></Grid></Border></Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Button x:Name="TodayButton" Content="Сегодня" Style="{StaticResource ActiveFilterButton}" Click="TodayButton_Click"/><Button x:Name="WeekButton" Content="Неделя" Style="{StaticResource FilterButton}" Click="WeekButton_Click"/><Button x:Name="MonthButton" Content="Месяц" Style="{StaticResource FilterButton}" Click="MonthButton_Click"/><Button x:Name="PeriodButton" Content="Период" Style="{StaticResource FilterButton}" Click="PeriodButton_Click"/><Button x:Name="EntranceButton" Content="Проходная" Style="{StaticResource FilterButton}" Click="EntranceButton_Click"/><Button x:Name="CanteenButton" Content="Столовая" Style="{StaticResource FilterButton}" Click="CanteenButton_Click"/></StackPanel><StackPanel x:Name="PeriodPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="FromText" Text="От" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="FromDatePicker" Width="145" SelectedDateChanged="CustomDateChanged"/><TextBlock x:Name="ToText" Text="До" VerticalAlignment="Center" Margin="14,0,8,0"/><DatePicker x:Name="ToDatePicker" Width="145" SelectedDateChanged="CustomDateChanged"/></StackPanel></StackPanel>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="EmployeeCards" ItemTemplate="{StaticResource EmployeeCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
        <StatusBar Grid.Row="4" Margin="0,16,0,0" Background="Transparent"><StatusBarItem><TextBlock x:Name="EventCountText" Text="Событий: 0" Foreground="#68727E"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="ConnectionStatusText" Text="Подключение..." Foreground="#68727E"/></StatusBarItem><StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="LastUpdateText" Foreground="#68727E"/></StatusBarItem></StatusBar>
    </Grid>
</Window>
