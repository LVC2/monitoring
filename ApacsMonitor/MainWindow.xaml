<Window x:Class="ApacsMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APACS Monitor — Журнал доступа"
        Icon="{StaticResource AppIcon}"
        Width="1400" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="FilterButton" TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="ActiveFilterButton" TargetType="Button" BasedOn="{StaticResource FilterButton}"><Setter Property="Background" Value="#17202A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#17202A"/></Style>
        <Style x:Key="ExportButton" TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="RefreshButton" TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17202A"/><Setter Property="BorderBrush" Value="#DDE3EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="WorkTimeButton" TargetType="Button"><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="Background" Value="#EEF4FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#D7E5FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="LanguageComboStyle" TargetType="ComboBox"><Setter Property="Width" Value="155"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="13"/></Style>
        <DataTemplate x:Key="LanguageItemTemplate"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="26" Height="20" CornerRadius="5" Background="#F1F5F9" Margin="0,0,9,0"><TextBlock Text="{Binding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#475569"/></Border><TextBlock Text="{Binding Content}" VerticalAlignment="Center" Foreground="#17202A"/></StackPanel></DataTemplate>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E8EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,16,16"/><Style.Triggers><DataTrigger Binding="{Binding RawObjectName}" Value="Canteen_1"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#93C5FD"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn1_Post1_IN"><Setter Property="BorderBrush" Value="#86EFAC"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn1_Post1_OUT"><Setter Property="BorderBrush" Value="#86EFAC"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_IN"><Setter Property="Background" Value="#FFFBEB"/><Setter Property="BorderBrush" Value="#FCD34D"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_OUT"><Setter Property="Background" Value="#FFFBEB"/><Setter Property="BorderBrush" Value="#FCD34D"/></DataTrigger></Style.Triggers></Style>
        <DataTemplate x:Key="EmployeeCardTemplate">
            <Border Style="{StaticResource CardStyle}" Width="380">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="27" Background="#EAF0F8"><Image Source="{StaticResource AppIcon}" Width="30" Height="30"/></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0"><TextBlock Text="Сотрудник" FontSize="12" Foreground="#7A8491"/><TextBlock Text="{Binding FullName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#17202A"/><TextBlock Text="{Binding CardNumber, StringFormat='Карта: {0}'}" FontSize="12" Foreground="#8A949F"/></StackPanel>
                        <Border Grid.Column="2" CornerRadius="9" Padding="9,5" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF7EF"/><Style.Triggers><DataTrigger Binding="{Binding RawObjectName}" Value="Canteen_1"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_IN"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_OUT"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Location}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#16834A"/><Style.Triggers><DataTrigger Binding="{Binding RawObjectName}" Value="Canteen_1"><Setter Property="Foreground" Value="#2563EB"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_IN"><Setter Property="Foreground" Value="#B45309"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_OUT"><Setter Property="Foreground" Value="#B45309"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#F5F7FA" CornerRadius="10" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ВРЕМЯ" FontSize="11" FontWeight="Bold" Foreground="#68727E"/><TextBlock Text="{Binding RealTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" FontSize="14" Foreground="#303944"/><TextBlock Text="{Binding Location}" FontSize="12" Foreground="#68727E" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ReaderName}" FontSize="12" Foreground="#68727E" TextWrapping="Wrap" MaxWidth="150" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
                    <StackPanel Grid.Row="3"><TextBlock Margin="2,10,0,0" Text="Реальный проход сотрудника" FontSize="11" Foreground="#68727E" TextWrapping="Wrap"/><Button Content="◷  Посмотреть часы сотрудника" Style="{StaticResource WorkTimeButton}" HorizontalAlignment="Left" Click="WorkTimeButton_Click" Tag="{Binding}"/></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="CompactListItemStyle" TargetType="ListViewItem"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="2,1"/><Style.Triggers><DataTrigger Binding="{Binding RawObjectName}" Value="Canteen_1"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn1_Post1_IN"><Setter Property="Background" Value="#F0FDF4"/><Setter Property="Foreground" Value="#15803D"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn1_Post1_OUT"><Setter Property="Background" Value="#F0FDF4"/><Setter Property="Foreground" Value="#15803D"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_IN"><Setter Property="Background" Value="#FFFBEB"/><Setter Property="Foreground" Value="#B45309"/></DataTrigger><DataTrigger Binding="{Binding RawObjectName}" Value="Turn2_Post1_OUT"><Setter Property="Background" Value="#FFFBEB"/><Setter Property="Foreground" Value="#B45309"/></DataTrigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="{StaticResource AppIcon}" Width="52" Height="52" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitleText" Text="APACS Monitor" FontSize="30" FontWeight="Bold" Foreground="#17202A"/><TextBlock x:Name="SubtitleText" Text="Журнал доступа сотрудников" FontSize="14" Foreground="#7A8491"/></StackPanel></StackPanel><ComboBox x:Name="LanguageComboBox" Grid.Column="1" Style="{StaticResource LanguageComboStyle}" ItemTemplate="{StaticResource LanguageItemTemplate}" SelectedIndex="0" SelectionChanged="LanguageComboBox_SelectionChanged"><ComboBoxItem Content="Русский" Tag="RU"/><ComboBoxItem Content="English" Tag="EN"/><ComboBoxItem Content="Türkçe" Tag="TR"/></ComboBox></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,16"><Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="11" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="22" VerticalAlignment="Center" Foreground="#68727E"/><TextBox x:Name="SearchTextBox" Grid.Column="1" BorderThickness="0" FontSize="15" Margin="10,0,0,0" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"/><TextBlock x:Name="SearchHint" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#A0A8B2" Text="Поиск по ФИО или номеру карты" IsHitTestVisible="False"/></Grid></Border></Grid>
        <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Button x:Name="AllButton" Content="Все" Style="{StaticResource FilterButton}" Click="AllButton_Click"/><Button x:Name="TodayButton" Content="Сегодня" Style="{StaticResource ActiveFilterButton}" Click="TodayButton_Click"/><Button x:Name="WeekButton" Content="Неделя" Style="{StaticResource FilterButton}" Click="WeekButton_Click"/><Button x:Name="MonthButton" Content="Месяц" Style="{StaticResource FilterButton}" Click="MonthButton_Click"/><Button x:Name="PeriodButton" Content="Период" Style="{StaticResource FilterButton}" Click="PeriodButton_Click"/></StackPanel><StackPanel x:Name="PeriodPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="FromText" Text="От" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="FromDatePicker" Width="145" SelectedDateChanged="CustomDateChanged"/><TextBlock x:Name="ToText" Text="До" VerticalAlignment="Center" Margin="14,0,8,0"/><DatePicker x:Name="ToDatePicker" Width="145" SelectedDateChanged="CustomDateChanged"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ViewModeButton" Content="☷  Кратко" Style="{StaticResource RefreshButton}" Click="ViewModeButton_Click"/><Button x:Name="RefreshButton" Content="↻  Обновить" Style="{StaticResource RefreshButton}" Click="RefreshButton_Click"/><Button x:Name="ExportButton" Content="⇩  Выгрузить Excel" Style="{StaticResource ExportButton}" Click="ExportButton_Click"/></StackPanel></Grid>
        <Grid Grid.Row="3"><ScrollViewer x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="EmployeeCards" ItemTemplate="{StaticResource EmployeeCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer><Border x:Name="CompactListBorder" Background="White" BorderBrush="#E3E8EE" BorderThickness="1" CornerRadius="10" Visibility="Collapsed"><ListView x:Name="CompactEventsList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CompactListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.View><GridView><GridViewColumn Header="Время" Width="165" DisplayMemberBinding="{Binding RealTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}/><GridViewColumn Header="Сотрудник" Width="290" DisplayMemberBinding="{Binding FullName}"/><GridViewColumn Header="Карта" Width="120" DisplayMemberBinding="{Binding CardNumber}"/><GridViewColumn Header="Место" Width="210" DisplayMemberBinding="{Binding Location}"/><GridViewColumn Header="Направление" Width="120" DisplayMemberBinding="{Binding Direction}"/><GridViewColumn Header="Считыватель" Width="260" DisplayMemberBinding="{Binding ReaderName}"/></GridView></ListView.View></ListView></Border></Grid>
        <Button x:Name="ShowMoreButton" Grid.Row="4" Content="Показать ещё 50" HorizontalAlignment="Center" Padding="24,10" Margin="0,10,0,0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="ShowMoreButton_Click" Visibility="Collapsed"/>
        <StatusBar Grid.Row="5" Margin="0,16,0,0" Background="Transparent"><StatusBarItem><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionIndicator" Width="10" Height="10" Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionStatusText" Text="Проверка подключения..." Foreground="#68727E" VerticalAlignment="Center"/></StackPanel></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="EventCountText" Text="Событий: 0" Foreground="#68727E"/></StatusBarItem><StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="LastUpdateText" Foreground="#68727E"/></StatusBarItem></StatusBar>
    </Grid>
</Window>