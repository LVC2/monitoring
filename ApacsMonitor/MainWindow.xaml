<Window x:Class="ApacsMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APACS Monitor"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="APACS Monitor" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Мониторинг событий системы APACS Apollo 3000" FontSize="13" Opacity="0.7" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="Обновить" Click="RefreshButton_Click" />
                <Button x:Name="SettingsButton" Content="Подключение" Click="SettingsButton_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Состояние:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionStatusText" Grid.Column="1" Text="Не подключено" Margin="10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LastUpdateText" Grid.Column="2" Text="" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <DataGrid x:Name="EventsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding RealTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="155" />
                <DataGridTextColumn Header="Регистрация" Binding="{Binding RegisterTime, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="155" />
                <DataGridTextColumn Header="Объект" Binding="{Binding InitObjectName}" Width="220" />
                <DataGridTextColumn Header="Тип события" Binding="{Binding EventType}" Width="100" />
                <DataGridTextColumn Header="Object 0" Binding="{Binding InitObjectId0}" Width="90" />
                <DataGridTextColumn Header="Object 1" Binding="{Binding InitObjectId1}" Width="90" />
                <DataGridTextColumn Header="SEK 0" Binding="{Binding SekId0}" Width="80" />
                <DataGridTextColumn Header="SEK 1" Binding="{Binding SekId1}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="EventCountText" Text="Событий: 0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="Источник: TAPCSYSEVENTSCOMMON" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
