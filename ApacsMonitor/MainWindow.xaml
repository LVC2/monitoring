<Window x:Class="ApacsMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APACS Monitor — Журнал доступа"
        Icon="{StaticResource AppIcon}"
        Width="1400"
        Height="900"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E8EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <DataTemplate x:Key="EmployeeCardTemplate">
            <Border Style="{StaticResource CardStyle}" Width="330">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="29" Background="#E9EEF5">
                            <Image Source="{StaticResource AppIcon}" Stretch="Uniform" Margin="13" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Сотрудник" FontSize="12" Foreground="#7A8491" />
                            <TextBlock Text="{Binding InitObjectName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Событие доступа" FontSize="12" Foreground="#9AA3AE" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="#F0F8F3" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="ВХОД" FontSize="11" FontWeight="Bold" Foreground="#16834B" /><TextBlock Text="{Binding RealTime, StringFormat='{}{0:dd MMMM yyyy}'}" FontSize="13" Foreground="#46505C" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RealTime, StringFormat='{}{0:HH:mm:ss}'}" FontSize="20" FontWeight="Bold" Foreground="#16834B" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Background="#FFF8E8" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="СТОЛОВАЯ" FontSize="11" FontWeight="Bold" Foreground="#B27600" /><TextBlock Text="—" FontSize="13" Foreground="#46505C" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="—" FontSize="20" FontWeight="Bold" Foreground="#B27600" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Background="#FFF0F0" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="ВЫХОД" FontSize="11" FontWeight="Bold" Foreground="#C43D3D" /><TextBlock Text="—" FontSize="13" Foreground="#46505C" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="—" FontSize="20" FontWeight="Bold" Foreground="#C43D3D" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource AppIcon}" Width="52" Height="52" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="APACS Monitor" FontSize="30" FontWeight="Bold" Foreground="#17202A" />
                    <TextBlock Text="Журнал доступа сотрудников" FontSize="14" Foreground="#7A8491" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="↻  Обновить" Click="RefreshButton_Click" />
                <Button x:Name="SettingsButton" Content="⚙  Подключение" Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="11" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" FontSize="22" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchTextBox" Grid.Column="1" BorderThickness="0" FontSize="15" Margin="10,0,0,0" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
                </Grid>
            </Border>
            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="150" Height="42" Margin="14,0,0,0" SelectedIndex="0">
                <ComboBoxItem Content="🌐  Русский" /><ComboBoxItem Content="🌐  English" /><ComboBoxItem Content="🌐  Türkçe" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="#17202A" CornerRadius="9" Padding="14,8" Margin="0,0,8,0"><TextBlock Text="Все" Foreground="White" FontWeight="SemiBold" /></Border>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,0,8,0"><TextBlock Text="Проходная" Foreground="#4E5965" /></Border>
                <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="9" Padding="14,8"><TextBlock Text="Столовая" Foreground="#4E5965" /></Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="EmployeeCards" ItemTemplate="{StaticResource EmployeeCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StatusBar Grid.Row="4" Margin="0,16,0,0" Background="Transparent">
            <StatusBarItem><TextBlock x:Name="EventCountText" Text="Сотрудников: 0" Foreground="#68727E" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="ConnectionStatusText" Text="Не подключено" Foreground="#68727E" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="LastUpdateText" Foreground="#68727E" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
