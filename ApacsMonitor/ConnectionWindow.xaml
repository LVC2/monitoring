<Window x:Class="ApacsMonitor.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение к APACS"
        Width="520"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Подключение к SQL Server" FontSize="24" FontWeight="Bold" Margin="0,0,0,18" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сервер:" VerticalAlignment="Center" />
            <TextBox x:Name="ServerTextBox" Grid.Column="1" Height="30" Padding="6" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="База данных:" VerticalAlignment="Center" />
            <TextBox x:Name="DatabaseTextBox" Grid.Column="1" Height="30" Padding="6" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Авторизация:" VerticalAlignment="Center" />
            <ComboBox x:Name="AuthenticationComboBox" Grid.Column="1" Height="30" SelectionChanged="AuthenticationComboBox_SelectionChanged">
                <ComboBoxItem Content="SQL Server" Tag="SqlServer" />
                <ComboBoxItem Content="Windows" Tag="Windows" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="UserNameTextBox" Height="30" Padding="6" Margin="0,0,0,8" />
                <PasswordBox x:Name="PasswordBox" Height="30" Padding="6" />
            </StackPanel>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Пользователь:" VerticalAlignment="Top" />
                <TextBlock Text="Пароль:" Margin="0,42,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,10">
            Пароль намеренно не сохраняется в appsettings.json. Он хранится только в памяти приложения до его закрытия.
        </TextBlock>

        <DockPanel Grid.Row="6" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Проверить" Click="TestButton_Click" />
                <Button Content="Подключиться" Click="ConnectButton_Click" IsDefault="True" />
                <Button Content="Отмена" Click="CancelButton_Click" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
